# Swing Trade Analyzer - API Keys Template
# v4.14 Multi-Source Data Intelligence
#
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# All providers have free tiers. Register at:

# TwelveData (OHLCV primary) - 800/day free
# Register: https://twelvedata.com/register
TWELVEDATA_API_KEY=

# Finnhub (Fundamentals primary) - 60/min free
# Register: https://finnhub.io/register
FINNHUB_API_KEY=

# Financial Modeling Prep (Growth metrics) - 250/day free
# Register: https://site.financialmodelingprep.com/register
FMP_API_KEY=

# Alpha Vantage (backup) - 25/day free
# Register: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# EODHD (backup) - 20/day free
# Register: https://eodhistoricaldata.com/register
EODHD_API_KEY=

# NOTE (Day 135): values here WIN over variables already in your terminal; the backend logs which key names it replaced.
# Set STA_ENV_OVERRIDE=0 in the launch environment to keep the old behaviour (terminal wins, with a warning).
# Alpaca (market data) - first US daily-price source (free Basic plan; the app asks for the SIP feed)
# Register: https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Not read by the app (Day 129): the Alpaca provider hard-codes feed=sip. IEX volume is a different, much smaller basis.
ALPACA_DATA_FEED=iex

# SimFin (historical fundamentals for backtest, free tier)
# Register: https://simfin.com
SIMFIN_API_KEY=
